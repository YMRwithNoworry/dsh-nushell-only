{
  "name": "dsh-nushell-only",
  "version": "0.4.0",
  "description": "Nushell-only shell executor, dialect preflight, and Nushell syntax teaching for DeepSeek Harness (dsh 0.1.7-rc.1): every ctx.shell execution runs as `nu --no-config-file -c`, other shells are refused, bash/PowerShell habits are refused before they spawn (including the ones Nushell silently misreads, like `2>$null`), a failed call carries an actionable Nushell hint verified against captured real Nushell stderr, and the model is taught Nushell.",
  "license": "MIT",
  "author": "dsh-nushell-only contributors",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./executor": {
      "default": "./lib/executor.js"
    },
    "./teaching": {
      "default": "./lib/teaching.js"
    },
    "./guide": {
      "default": "./lib/guide.js"
    },
    "./guard": {
      "default": "./lib/guard.js"
    },
    "./nu": {
      "default": "./lib/nu.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "nushell",
    "nu",
    "shell",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YMRwithNoworry/dsh-nushell-only.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/",
    "test:integration": "node test/integration.mjs",
    "test:integration:confined": "node test/integration.mjs --mode workspace-write",
    "fixtures": "node dev/capture-nu-errors.mjs",
    "link-peers": "node dev/link-peers.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-bash-sandbox": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-pwsh-sandbox": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-sandbox": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-shell": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-subprocess": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.7-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-bash-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-pwsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox-policy": {
      "optional": true
    },
    "@deepseek-ai/dsh-shell": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
